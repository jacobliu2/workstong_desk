["dragenter","dragover"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add("hover");}));
["dragleave","drop"].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove("hover");}));
drop.addEventListener("drop",e=>{if(e.dataTransfer.files[0])handleFile(e.dataTransfer.files[0]);});
$("postSearch").oninput=renderPosts;$("postYear").onchange=renderPosts;$("postSort").onchange=renderPosts;
$("postSource").onchange=()=>{buildArcStats();renderPosts();};
$("expMd").onclick=()=>exportPosts("md");$("expJson").onclick=()=>exportPosts("json");$("expHtml").onclick=()=>exportPosts("html");

