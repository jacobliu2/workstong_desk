<script>
"use strict";

/* ========== 설정 ========== */
// 여기에 직접 박아두어도 되고(아래 두 줄), 비워두면 첫 실행 시 화면에서 입력받습니다.
let SUPABASE_URL = "";
let SUPABASE_ANON_KEY = "";

const LS_URL="tong_sb_url", LS_KEY="tong_sb_key";
// 입력 URL에서 베이스(origin)만 추출 — /rest/v1 같은 경로·끝 슬래시·공백을 제거해 'Invalid path' 오류 방지
function normalizeUrl(u){u=(u||"").trim();if(!u)return"";try{return new URL(u).origin;}catch(e){return u.replace(/\/+$/,"");}}
SUPABASE_URL  = normalizeUrl(SUPABASE_URL || localStorage.getItem(LS_URL) || "");
SUPABASE_ANON_KEY = (SUPABASE_ANON_KEY || localStorage.getItem(LS_KEY) || "").trim();
// 이전에 잘못 저장된 URL이 있으면 정규화된 값으로 덮어쓰기
if(SUPABASE_URL && localStorage.getItem(LS_URL) && localStorage.getItem(LS_URL)!==SUPABASE_URL){localStorage.setItem(LS_URL,SUPABASE_URL);}

let sb=null, USER=null;
const SERIES_LABEL={};
const STATUS=[
