<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>유영준의 책상</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root{
    --primary:#3684FF; --light:#6BA3FF; --bg:#f8faff;
    --glass:rgba(255,255,255,0.75); --glass-border:rgba(54,132,255,0.15);
    --ink:#1a2332; --ink-soft:#5a6b85; --ink-faint:#9aa7bd;
    --radius:16px; --shadow:0 8px 32px rgba(54,132,255,0.10);
    --seed:#9aa7bd; --dev:#6BA3FF; --write:#3684FF; --done:#2bb673;
    --src-linkedin:#3684FF; --src-brunch:#2bb673; --src-column:#e08a2b; --src-poem:#7c5cff; --src-etc:#9aa7bd;
  }
  *{box-sizing:border-box;margin:0;padding:0;font-style:normal !important;}
  body{font-family:'Noto Sans KR',sans-serif;background:var(--bg);color:var(--ink);
    line-height:1.6;-webkit-font-smoothing:antialiased;min-height:100vh;position:relative;padding:0 16px 60px;}
  body::before{content:"";position:fixed;inset:0;z-index:-1;
    background:
      radial-gradient(ellipse 80% 60% at 15% 0%, rgba(54,132,255,0.10), transparent 60%),
      radial-gradient(ellipse 70% 50% at 100% 10%, rgba(107,163,255,0.10), transparent 55%),
      radial-gradient(ellipse 90% 70% at 50% 110%, rgba(54,132,255,0.06), transparent 60%);}
  .wrap{max-width:1080px;margin:0 auto;}
  .card{background:var(--glass);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
    border:1px solid var(--glass-border);border-radius:var(--radius);box-shadow:var(--shadow);
    position:relative;overflow:hidden;}
  .accent-top::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;
    background:linear-gradient(90deg,var(--primary),var(--light));}
  @keyframes popIn{from{opacity:0;transform:translateY(14px) scale(.985);}to{opacity:1;transform:none;}}
  .pop{animation:popIn .45s cubic-bezier(.2,.8,.25,1) both;}

  /* Header */
  header{display:flex;align-items:center;justify-content:space-between;padding:26px 4px 18px;flex-wrap:wrap;gap:12px;}
  .logo{font-family:'Noto Sans KR',sans-serif;font-weight:700;font-size:24px;color:var(--ink);letter-spacing:-.01em;}
  .logo b{color:var(--primary);}
  .logo small{display:block;font-family:'Noto Sans KR';font-size:11px;letter-spacing:.18em;
    color:var(--primary);font-weight:700;text-transform:uppercase;margin-top:2px;}
  .user-box{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--ink-soft);}
  .btn{padding:9px 16px;border:none;border-radius:10px;font-family:inherit;font-size:13px;font-weight:700;
    cursor:pointer;transition:.18s;}
  .btn-pri{background:var(--primary);color:#fff;box-shadow:0 6px 16px rgba(54,132,255,.28);}
  .btn-pri:hover{background:#2670e8;transform:translateY(-1px);}
  .btn-ghost{background:rgba(54,132,255,.08);color:var(--primary);}
  .btn-ghost:hover{background:rgba(54,132,255,.16);}

  /* Tabs */
  .tabs{display:flex;gap:6px;margin-bottom:18px;}
  .tab{padding:11px 22px;border:none;border-radius:11px;background:transparent;font-family:inherit;
    font-size:14px;font-weight:700;color:var(--ink-faint);cursor:pointer;transition:.18s;}
  .tab.active{background:var(--glass);color:var(--primary);box-shadow:var(--shadow);
    border:1px solid var(--glass-border);}
  .view{display:none;}.view.active{display:block;animation:popIn .4s both;}

  /* Idea quick input */
  .quick{padding:18px 20px;margin-bottom:16px;}
  .quick-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
  .quick input.title{flex:1;min-width:220px;padding:13px 16px;border:1px solid var(--glass-border);
    border-radius:11px;font-family:inherit;font-size:15px;background:#fff;color:var(--ink);}
  .quick input.title:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(54,132,255,.12);}
  select,.sel{padding:13px 12px;border:1px solid var(--glass-border);border-radius:11px;
    font-family:inherit;font-size:13px;background:#fff;color:var(--ink);cursor:pointer;}
  select:focus{outline:none;border-color:var(--primary);}
  .quick-hint{font-size:12px;color:var(--ink-faint);margin-top:10px;}

  /* Kanban */
  .board-tools{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px;}
  .board-tools .search{flex:1;min-width:180px;position:relative;}
  .board-tools .search input{width:100%;padding:11px 14px 11px 38px;border:1px solid var(--glass-border);
    border-radius:11px;font-family:inherit;font-size:14px;background:#fff;}
  .board-tools .search input:focus{outline:none;border-color:var(--primary);}
  .board-tools .search svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:15px;height:15px;fill:var(--ink-faint);}
  .view-toggle{display:flex;border:1px solid var(--glass-border);border-radius:10px;overflow:hidden;}
  .view-toggle button{padding:10px 14px;border:none;background:#fff;font-family:inherit;font-size:12.5px;
    font-weight:700;color:var(--ink-faint);cursor:pointer;}
  .view-toggle button.on{background:var(--primary);color:#fff;}

  .kanban{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;}
  @media(max-width:820px){.kanban{display:flex;overflow-x:auto;padding-bottom:8px;}
    .kanban .col{min-width:260px;}}
  .col{background:rgba(255,255,255,.5);border:1px solid var(--glass-border);border-radius:14px;padding:12px;}
  .col-head{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;margin-bottom:12px;padding:0 4px;}
  .dot{width:9px;height:9px;border-radius:50%;}
  .col-count{margin-left:auto;font-size:11px;color:var(--ink-faint);background:rgba(54,132,255,.08);
    padding:1px 9px;border-radius:20px;}

  .idea{background:#fff;border:1px solid var(--glass-border);border-radius:11px;padding:13px 14px;
    margin-bottom:10px;cursor:pointer;transition:.16s;animation:popIn .35s both;}
  .idea:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(54,132,255,.14);}
  .idea .it{font-size:14px;font-weight:700;color:var(--ink);line-height:1.4;}
  .idea .ic{font-size:12.5px;color:var(--ink-soft);margin-top:6px;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .badges{display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;}
  .badge{font-size:10.5px;font-weight:700;padding:2px 9px;border-radius:20px;
    background:rgba(54,132,255,.10);color:var(--primary);}
  .badge.ch{background:rgba(43,182,115,.12);color:#1e9e5f;}
  .idea .when{font-size:10.5px;color:var(--ink-faint);margin-top:8px;}

  /* list view */
  .list-row{background:#fff;border:1px solid var(--glass-border);border-radius:11px;padding:14px 16px;
    margin-bottom:9px;display:flex;align-items:center;gap:12px;cursor:pointer;transition:.16s;animation:popIn .3s both;}
  .list-row:hover{box-shadow:0 4px 14px rgba(54,132,255,.12);}
  .list-row .st{width:8px;height:8px;border-radius:50%;flex-shrink:0;}
  .list-row .lt{flex:1;min-width:0;}
  .list-row .lt b{font-size:14px;display:block;}
  .list-row .lt span{font-size:12px;color:var(--ink-faint);}

  /* Archive */
  .arc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:14px;}
  @media(max-width:560px){.arc-stats{grid-template-columns:repeat(2,1fr);}}
  .stat{padding:18px 12px;text-align:center;}
  .stat .num{font-family:'DM Serif Display',serif;font-size:28px;color:var(--primary);line-height:1;}
  .stat .lbl{font-size:11.5px;color:var(--ink-soft);margin-top:7px;}
  #drop{padding:30px;text-align:center;margin-bottom:14px;cursor:pointer;transition:.2s;}
  #drop.hover{background:rgba(54,132,255,.06);}
  #drop h3{font-size:16px;margin-bottom:6px;}
  #drop p{font-size:13px;color:var(--ink-soft);}
  #drop .pick{margin-top:14px;}
  .arc-tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px;align-items:center;}
  .arc-tools .search{flex:1;min-width:180px;position:relative;}
  .arc-tools .search input{width:100%;padding:11px 14px 11px 38px;border:1px solid var(--glass-border);border-radius:11px;font-family:inherit;font-size:14px;background:#fff;}
  .arc-tools .search input:focus{outline:none;border-color:var(--primary);}
  .arc-tools .search svg{position:absolute;left:13px;top:50%;transform:translateY(-50%);width:15px;height:15px;fill:var(--ink-faint);}
  .post{padding:18px 20px;margin-bottom:12px;}
  .post .date{font-size:12px;color:var(--primary);font-weight:700;}
  .post .body{margin-top:9px;font-size:14.5px;white-space:pre-wrap;word-break:break-word;}
  .post .body mark{background:rgba(54,132,255,.22);border-radius:3px;}
  .post .foot{margin-top:12px;display:flex;gap:14px;align-items:center;flex-wrap:wrap;}
  .post .foot a{font-size:12px;color:var(--primary);text-decoration:none;font-weight:500;}
  .post .foot a:hover{text-decoration:underline;}
  .post .chars{font-size:11.5px;color:var(--ink-faint);}

  /* Auth / Setup gate */
  .gate{max-width:440px;margin:8vh auto 0;padding:38px 32px;text-align:center;}
  .gate .glogo{font-family:'Noto Sans KR',sans-serif;font-weight:700;font-size:28px;color:var(--primary);}
  .gate p{color:var(--ink-soft);font-size:14px;margin:10px 0 22px;line-height:1.7;}
  .gate input{width:100%;padding:13px 16px;border:1px solid var(--glass-border);border-radius:11px;
    font-family:inherit;font-size:14px;margin-bottom:10px;background:#fff;}
  .gate input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(54,132,255,.12);}
  .gate .btn-pri{width:100%;padding:13px;font-size:15px;margin-top:4px;}
  .gate .note{font-size:11.5px;color:var(--ink-faint);margin-top:16px;line-height:1.7;}
  .gate a{color:var(--primary);text-decoration:none;}

  /* Modal */
  .modal-bg{position:fixed;inset:0;background:rgba(26,35,50,.4);backdrop-filter:blur(4px);
    z-index:100;display:none;align-items:center;justify-content:center;padding:20px;}
  .modal-bg.show{display:flex;}
  .modal{background:#fff;border-radius:18px;max-width:540px;width:100%;padding:28px;
    max-height:90vh;overflow:auto;animation:popIn .3s both;position:relative;}
  .modal h3{font-family:'DM Serif Display',serif;font-size:22px;color:var(--ink);margin-bottom:18px;}
  .modal label{display:block;font-size:12px;font-weight:700;color:var(--ink-soft);margin:14px 0 6px;}
  .modal input,.modal textarea,.modal select{width:100%;padding:11px 14px;border:1px solid var(--glass-border);
    border-radius:10px;font-family:inherit;font-size:14px;background:#fff;color:var(--ink);}
  .modal textarea{min-height:140px;resize:vertical;line-height:1.7;}
  .modal input:focus,.modal textarea:focus,.modal select:focus{outline:none;border-color:var(--primary);}
  .modal .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .modal-foot{display:flex;gap:10px;margin-top:22px;}
  .modal-foot .btn-pri{flex:1;padding:12px;}
  .btn-del{background:rgba(255,90,90,.10);color:#d33;padding:12px 18px;border:none;border-radius:10px;
    font-family:inherit;font-weight:700;font-size:13px;cursor:pointer;}
  .btn-del:hover{background:rgba(255,90,90,.2);}

  /* Toast */
  #toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);
    background:var(--ink);color:#fff;padding:12px 22px;border-radius:12px;font-size:13.5px;font-weight:500;
    opacity:0;transition:.3s;z-index:200;pointer-events:none;box-shadow:0 10px 30px rgba(0,0,0,.2);}
  #toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  #toast.err{background:#c0392b;}

  .empty{text-align:center;padding:40px 20px;color:var(--ink-faint);font-size:13.5px;}
  .spinner{width:30px;height:30px;border:3px solid rgba(54,132,255,.2);border-top-color:var(--primary);
    border-radius:50%;animation:spin .7s linear infinite;margin:30px auto;}
  @keyframes spin{to{transform:rotate(360deg);}}
  footer{text-align:center;margin-top:40px;font-size:11.5px;color:var(--ink-faint);}
</style>
</head>
<body>

<!-- ============ SETUP / AUTH GATE ============ -->
<div id="gate" class="wrap" style="display:none;">
  <!-- Supabase 설정 -->
  <div id="setupGate" class="card accent-top gate pop" style="display:none;">
    <div class="glogo">유영준의 책상</div>
    <p>처음 한 번만, Supabase 연결 정보를 입력하세요.<br>이 정보는 이 브라우저에만 저장됩니다.</p>
    <input id="sbUrl" placeholder="Supabase URL (https://xxxx.supabase.co)">
    <input id="sbKey" placeholder="anon public key">
    <button class="btn btn-pri" id="saveSetup">연결하기</button>
    <div class="note">
      Supabase Dashboard → Project Settings → API 에서<br>
      <b>Project URL</b> 과 <b>anon public</b> 키를 복사하세요.<br>
      (service_role 키는 절대 입력하지 마세요)
    </div>
  </div>
  <!-- 로그인 -->
  <div id="authGate" class="card accent-top gate pop" style="display:none;">
    <div class="glogo">유영준의 책상</div>
    <p>이메일과 비밀번호로 로그인하세요.<br>처음이시면 아래 "가입하기"를 먼저 누르세요.</p>
    <input id="email" type="email" placeholder="이메일 주소" autocomplete="email">
    <input id="password" type="password" placeholder="비밀번호 (6자 이상)" autocomplete="current-password">
    <button class="btn btn-pri" id="loginBtn">로그인</button>
    <button class="btn btn-ghost" id="signupBtn" style="width:100%;margin-top:8px;padding:13px;">처음이에요 · 가입하기</button>
    <div class="note" id="authNote">
      한 번 로그인하면 이 브라우저에 세션이 유지되어 다음부터 자동 로그인됩니다.<br>
      <a href="#" id="resetSetup">연결 정보 다시 설정</a>
    </div>
  </div>
</div>

<!-- ============ MAIN APP ============ -->
<div id="app" class="wrap" style="display:none;">
  <header>
    <div class="logo">유영준의 책상<small>The Desk · 업무를 잇다 TONG</small></div>
    <div class="user-box">
      <span id="whoami"></span>
      <button class="btn btn-ghost" id="logout">로그아웃</button>
    </div>
  </header>

  <div class="tabs">
    <button class="tab active" data-view="ideas">✍️ 글감</button>
    <button class="tab" data-view="archive">🗂️ 아카이브</button>
  </div>

  <!-- ===== 글감 ===== -->
  <div class="view active" id="view-ideas">
    <div class="card accent-top quick">
      <div class="quick-row">
        <input class="title" id="qTitle" placeholder="떠오른 글감을 적으세요… (Enter 저장)">
        <select id="qSeries">
          <option value="">시리즈</option>
          <option>인사만사</option><option>고인돌</option><option>비즈니스 삼십육계</option>
          <option>군왕의 곁</option><option>너나이</option><option>경영전환론</option><option>기타</option>
        </select>
        <select id="qChannel">
          <option value="">채널</option>
          <option>브런치</option><option>링크드인</option><option>칼럼</option><option>책</option><option>기타</option>
        </select>
        <button class="btn btn-pri" id="qAdd">추가</button>
      </div>
      <div class="quick-hint">제목만 빠르게 적고 Enter. 자세한 내용·상태는 카드를 눌러 편집하세요.</div>
    </div>

    <div class="board-tools">
      <div class="search">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 10-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1114 9.5 4.5 4.5 0 019.5 14z"/></svg>
        <input id="ideaSearch" placeholder="글감 검색…">
      </div>
      <select id="ideaSeriesFilter"><option value="">전체 시리즈</option>
        <option>인사만사</option><option>고인돌</option><option>비즈니스 삼십육계</option>
        <option>군왕의 곁</option><option>너나이</option><option>경영전환론</option><option>기타</option>
      </select>
      <div class="view-toggle">
        <button id="vbKanban" class="on">칸반</button>
        <button id="vbList">리스트</button>
      </div>
    </div>

    <div id="ideaArea"><div class="spinner"></div></div>
  </div>

  <!-- ===== 아카이브 ===== -->
  <div class="view" id="view-archive">
    <div class="arc-stats" id="arcStats"></div>
    <div class="card accent-top" id="drop">
      <h3>글 가져오기</h3>
      <p>LinkedIn 데이터 export(.zip/Shares.csv)를 끌어다 놓으면 클라우드에 저장됩니다 (중복 자동 제외)</p>
      <button class="btn btn-pri pick" id="pickBtn">파일 선택</button>
      <button class="btn btn-ghost pick" id="addPostBtn" style="margin-left:8px;">＋ 글 직접 추가 (브런치·칼럼 등)</button>
      <button class="btn btn-ghost pick" id="importJsonBtn" style="margin-left:8px;">⬆ JSON 가져오기</button>
      <input type="file" id="fileInput" accept=".zip,.csv,.json" style="display:none">
      <div id="impMsg" style="margin-top:12px;font-size:13px;"></div>
    </div>
    <div class="arc-tools">
      <div class="search">
        <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 10-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0A4.5 4.5 0 1114 9.5 4.5 4.5 0 019.5 14z"/></svg>
        <input id="postSearch" placeholder="제목·본문 검색…">
      </div>
      <select id="postSource"><option value="">전체 출처</option>
        <option value="linkedin">링크드인</option><option value="brunch">브런치</option>
        <option value="column">칼럼</option><option value="poem">시</option><option value="etc">기타</option>
      </select>
      <select id="postYear"><option value="">전체 연도</option></select>
      <select id="postSort">
        <option value="new">최신순</option><option value="old">오래된순</option>
        <option value="long">긴 글 순</option><option value="short">짧은 글 순</option>
      </select>
      <button class="btn btn-ghost" id="expMd">MD</button>
      <button class="btn btn-ghost" id="expJson">JSON</button>
      <button class="btn btn-ghost" id="expHtml">HTML</button>
    </div>
    <div id="postArea"><div class="empty">아직 가져온 글이 없습니다.</div></div>
  </div>

  <footer>경영전환전략연구소 통 · 개인 글쓰기 작업대 · Supabase 동기화</footer>
</div>

<!-- ============ IDEA EDIT MODAL ============ -->
<div class="modal-bg" id="modalBg">
  <div class="modal">
    <h3 id="mTitle">글감 편집</h3>
    <label>제목</label>
    <input id="mTitleIn" placeholder="제목">
    <label>내용</label>
    <textarea id="mContent" placeholder="구체적인 생각, 구조, 인용, 참고 자료…"></textarea>
    <div class="grid2">
      <div><label>시리즈</label>
        <select id="mSeries"><option value="">없음</option>
          <option>인사만사</option><option>고인돌</option><option>비즈니스 삼십육계</option>
          <option>군왕의 곁</option><option>너나이</option><option>경영전환론</option><option>기타</option>
        </select></div>
      <div><label>채널</label>
        <select id="mChannel"><option value="">없음</option>
          <option>브런치</option><option>링크드인</option><option>칼럼</option><option>책</option><option>기타</option>
        </select></div>
    </div>
    <label>상태</label>
    <select id="mStatus">
      <option value="seed">🌱 씨앗</option><option value="dev">🌿 발전</option>
      <option value="write">✍️ 집필</option><option value="done">✅ 완료</option>
    </select>
    <div class="modal-foot">
