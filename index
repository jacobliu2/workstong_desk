/* ========== 아카이브 (CSV 파서 재사용) ========== */
function parseCSV(text){
  if(text.charCodeAt(0)===0xFEFF)text=text.slice(1);
  const rows=[];let row=[],field="",i=0,inQ=false;const n=text.length;
  while(i<n){const c=text[i];
    if(inQ){if(c==='"'){if(text[i+1]==='"'){field+='"';i+=2;continue;}inQ=false;i++;continue;}field+=c;i++;continue;}
    if(c==='"'){inQ=true;i++;continue;}
    if(c===','){row.push(field);field="";i++;continue;}
    if(c==='\r'){i++;continue;}
    if(c==='\n'){row.push(field);rows.push(row);row=[];field="";i++;continue;}
    field+=c;i++;}
  if(field.length>0||row.length>0){row.push(field);rows.push(row);}
  return rows;
}
function rowsToObjects(rows){
  if(!rows.length)return[];const h=rows[0].map(x=>x.trim());const out=[];
  for(let r=1;r<rows.length;r++){const c=rows[r];if(c.length===1&&c[0]==="")continue;
    const o={};h.forEach((k,idx)=>o[k]=c[idx]!==undefined?c[idx]:"");out.push(o);}
  return out;
}
function detectColumns(objs){
  if(!objs.length)return null;const headers=Object.keys(objs[0]);const low=headers.map(h=>h.toLowerCase());
  const find=(...keys)=>{for(const k of keys){const i=low.findIndex(h=>h.includes(k));if(i>=0)return headers[i];}return null;};
  let body=find("commentary","sharecommentary","text","content","message","comment");
  const date=find("date","time","created","published"),link=find("sharelink","permalink","link","url"),media=find("media","image","photo");
  if(!body){let best=null,bl=-1;headers.forEach(h=>{let s=0,c=0;for(let k=0;k<Math.min(objs.length,200);k++){s+=(objs[k][h]||"").length;c++;}const a=c?s/c:0;if(a>bl){bl=a;best=h;}});body=best;}
  return {body,date,link,media};
}
function parseLiDate(s){if(!s)return null;s=s.trim();let d=new Date(s.replace(" ","T"));if(isNaN(d))d=new Date(s);return isNaN(d)?null:d;}

/* 파일 → posts → Supabase upsert */
function handleFile(file){
  const name=file.name.toLowerCase();
  if(name.endsWith(".csv")){const r=new FileReader();r.onload=e=>importCSV(e.target.result);r.readAsText(file,"UTF-8");}
  else if(name.endsWith(".json")){const r=new FileReader();r.onload=e=>importJSON(e.target.result);r.readAsText(file,"UTF-8");}
  else if(name.endsWith(".zip")){handleZip(file);}
  else{toast(".zip / .csv / .json 파일을 올려주세요",true);}
}

/* JSON 가져오기 — export JSON 또는 Claude가 만든 글 배열을 적재 (중복 자동 제외) */
async function importJSON(text){
  let arr;
  try{arr=JSON.parse(text);}catch(e){$("impMsg").textContent="JSON 형식 오류입니다.";return;}
  if(!Array.isArray(arr)){
    // {posts:[...]} 형태도 허용
    if(arr&&Array.isArray(arr.posts))arr=arr.posts; else {$("impMsg").textContent="글 배열(JSON)이 아닙니다.";return;}
  }
  if(!arr.length){$("impMsg").textContent="가져올 글이 없습니다.";return;}
  // 기존 글과 중복 비교용 키셋 (출처+제목+본문)
  const key=p=>((p.source||"")+"||"+(p.title||"")+"||"+(p.body||"")).trim();
  const existing=new Set(POSTS.map(key));
  const rows=arr.map(p=>{
    const body=(p.body||"").toString();
    return {
      source:p.source||"etc",
      title:(p.title||"").toString().trim()||null,
      body:body||null,
      link:(p.link||"").toString().trim()||null,
      tags:Array.isArray(p.tags)?p.tags:(p.tags?String(p.tags).split(",").map(s=>s.trim()).filter(Boolean):null),
      rating:Number(p.rating)||0,
      posted_at:p.date?new Date(p.date).toISOString():(p.posted_at?new Date(p.posted_at).toISOString():null),
      char_count:body.length
    };
  }).filter(p=>(p.title||p.body) && !existing.has(((p.source||"")+"||"+(p.title||"")+"||"+(p.body||"")).trim()));
  if(!rows.length){$("impMsg").textContent="새로 추가할 글이 없습니다 (모두 이미 존재).";return;}
  $("impMsg").textContent=rows.length+"개 업로드 중…";
  // 500개씩 나눠 insert (대량 대응)
  let ok=0,fail=0;
  for(let i=0;i<rows.length;i+=500){
    const chunk=rows.slice(i,i+500);
    const {error}=await sb.from("archived_posts").insert(chunk);
    if(error)fail+=chunk.length;else ok+=chunk.length;
  }
  $("impMsg").innerHTML=fail?("일부 실패. "+ok+"개 추가됨."):("✅ "+ok+"개 추가 완료 (중복 제외)");
  loadPosts();
}
function handleZip(file){
  $("impMsg").textContent="ZIP 여는 중…";
  loadJSZip().then(JSZip=>JSZip.loadAsync(file)).then(zip=>{
    let t=null;zip.forEach((p,e)=>{if(!e.dir&&p.toLowerCase().endsWith("shares.csv"))t=e;});
    if(!t)zip.forEach((p,e)=>{const pp=p.toLowerCase();if(!e.dir&&pp.endsWith(".csv")&&(pp.includes("share")||pp.includes("post")))t=t||e;});
    if(!t)zip.forEach((p,e)=>{if(!e.dir&&p.toLowerCase().endsWith(".csv"))t=t||e;});
    if(!t){$("impMsg").textContent="ZIP에서 게시물 CSV를 찾지 못했습니다.";return;}
    return t.async("string").then(importCSV);
  }).catch(()=>{$("impMsg").innerHTML="ZIP 처리 실패. 압축을 풀어 Shares.csv 를 직접 올려주세요.";});
}
function loadJSZip(){return new Promise((res,rej)=>{if(window.JSZip)return res(window.JSZip);
  const s=document.createElement("script");s.src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js";
  s.onload=()=>window.JSZip?res(window.JSZip):rej();s.onerror=()=>rej();document.head.appendChild(s);});}

async function importCSV(text){
  $("impMsg").textContent="분석 중…";
  const objs=rowsToObjects(parseCSV(text));const cols=detectColumns(objs);
  if(!cols||!cols.body){$("impMsg").textContent="본문 컬럼을 찾지 못했습니다.";return;}
  const rows=objs.map(o=>{
    const body=(o[cols.body]||"").trim();const d=cols.date?parseLiDate(o[cols.date]):null;
    return {body,
      posted_at:d?d.toISOString():null,
      link:(cols.link?(o[cols.link]||"").trim():"")||null,
      media:cols.media?(o[cols.media]||"").trim():"",
      char_count:body.length, source:"linkedin"};
  }).filter(p=>p.body||p.media);
  if(!rows.length){$("impMsg").textContent="가져올 글이 없습니다.";return;}
  $("impMsg").textContent=rows.length+"개 업로드 중…";
  // link 있는 것은 upsert(중복제거), 없는 것은 insert
  const withLink=rows.filter(r=>r.link),noLink=rows.filter(r=>!r.link);
  let ok=0,fail=0;
  if(withLink.length){
    const {error}=await sb.from("archived_posts").upsert(withLink,{onConflict:"user_id,link",ignoreDuplicates:true});
    if(error)fail+=withLink.length;else ok+=withLink.length;
  }
  if(noLink.length){
    const {error}=await sb.from("archived_posts").insert(noLink);
    if(error)fail+=noLink.length;else ok+=noLink.length;
  }
  $("impMsg").innerHTML=fail? "일부 실패. "+ok+"개 처리됨.":"✅ "+ok+"개 처리 완료 (중복은 자동 제외)";
  loadPosts();
}

async function loadPosts(){
  const {data,error}=await sb.from("archived_posts").select("*").order("posted_at",{ascending:false});
  if(error){$("postArea").innerHTML='<div class="empty">불러오기 실패</div>';return;}
  POSTS=data||[];buildSourceFilter();buildArcStats();buildYearFilter();renderPosts();
}
function buildSourceFilter(){
  const counts={};POSTS.forEach(p=>{const s=p.source||"linkedin";counts[s]=(counts[s]||0)+1;});
  const sel=$("postSource");const cur=sel.value;
  sel.innerHTML='<option value="">전체 출처 ('+POSTS.length+')</option>'+
    Object.keys(SOURCE_META).map(k=>'<option value="'+k+'">'+SOURCE_META[k].label+' ('+(counts[k]||0)+')</option>').join("");
  sel.value=cur;
}
function buildArcStats(){
  const src=$("postSource").value;
  const base=src?POSTS.filter(p=>(p.source||"linkedin")===src):POSTS;
  const total=base.length;const chars=base.reduce((s,p)=>s+(p.char_count||0),0);
  const withText=base.filter(p=>(p.char_count||0)>0).length;const avg=withText?Math.round(chars/withText):0;
  const dates=base.map(p=>p.posted_at).filter(Boolean).sort();let span="–";
  if(dates.length){const f=new Date(dates[0]),l=new Date(dates[dates.length-1]);
    const m=(l.getFullYear()-f.getFullYear())*12+(l.getMonth()-f.getMonth())+1;
    span=m>=12?Math.floor(m/12)+"년 "+(m%12)+"개월":m+"개월";}
  const st=[[total.toLocaleString(),"총 글"],[span,"활동 기간"],[chars.toLocaleString(),"총 글자 수"],[avg.toLocaleString(),"평균 글자"]];
  $("arcStats").innerHTML=st.map(s=>'<div class="card stat"><div class="num">'+s[0]+'</div><div class="lbl">'+s[1]+'</div></div>').join("");
}
function buildYearFilter(){
  const years=[...new Set(POSTS.map(p=>p.posted_at?new Date(p.posted_at).getFullYear():null).filter(Boolean))].sort((a,b)=>b-a);
  const sel=$("postYear");sel.innerHTML='<option value="">전체 연도</option>'+years.map(y=>'<option>'+y+'</option>').join("");
}
function highlight(t,q){const s=escapeHtml(t);if(!q)return s;
  return s.replace(new RegExp("("+q.replace(/[.*+?^${}()|[\]\\]/g,"\\$&")+")","gi"),'<mark>$1</mark>');}
function renderPosts(){
  const q=$("postSearch").value.trim();const year=$("postYear").value;const sort=$("postSort").value;
  const src=$("postSource").value;
  let v=POSTS.filter(p=>{
    if(src&&(p.source||"linkedin")!==src)return false;
    if(year&&(!p.posted_at||new Date(p.posted_at).getFullYear()!=year))return false;
    if(q){const hay=((p.title||"")+" "+(p.body||"")+" "+((p.tags||[]).join(" "))).toLowerCase();if(!hay.includes(q.toLowerCase()))return false;}
    return true;});
  v.sort((a,b)=>{const da=a.posted_at?new Date(a.posted_at):0,db=b.posted_at?new Date(b.posted_at):0;
    if(sort==="new")return db-da;if(sort==="old")return da-db;
    if(sort==="long")return (b.char_count||0)-(a.char_count||0);if(sort==="short")return (a.char_count||0)-(b.char_count||0);return 0;});
  const area=$("postArea");
  if(!v.length){area.innerHTML='<div class="empty">조건에 맞는 글이 없습니다.</div>';return;}
  area.innerHTML=v.slice(0,300).map(p=>{
    const m=srcMeta(p.source);
    const srcBadge='<span class="badge" style="background:'+m.color+'1f;color:'+m.color+'">'+m.label+'</span>';
    const stars=p.rating?' <span style="color:#f5a623;font-size:12px;">'+"★".repeat(p.rating)+'</span>':'';
    const titleHtml=p.title?'<div style="font-size:15px;font-weight:700;margin:6px 0 2px;">'+highlight(p.title,q)+'</div>':'';
    const body=p.body?highlight(p.body,q):(p.title?'':'<span style="color:var(--ink-faint)">(본문 없음 · 미디어)</span>');
    const tagHtml=(p.tags&&p.tags.length)?'<div class="badges">'+p.tags.map(t=>'<span class="badge ch">#'+escapeHtml(t)+'</span>').join("")+'</div>':'';
    const link=p.link?'<a href="'+escapeHtml(p.link)+'" target="_blank" rel="noopener">원문 ↗</a>':'';
    return '<div class="card accent-top post" data-pid="'+p.id+'">'+
      '<div class="date">'+fmtDate(p.posted_at)+' '+srcBadge+stars+'</div>'+
      titleHtml+
      '<div class="body">'+body+'</div>'+
      tagHtml+
      '<div class="foot">'+link+'<span class="chars">'+(p.char_count||0).toLocaleString()+'자</span>'+
      '<span class="chars" style="color:var(--primary);cursor:pointer;" data-edit="'+p.id+'">편집</span></div></div>';
  }).join("")+(v.length>300?'<div class="empty">상위 300개 표시. 검색으로 좁혀보세요.</div>':"");
  area.querySelectorAll("[data-edit]").forEach(el=>el.onclick=ev=>{ev.stopPropagation();openPostModal(el.dataset.edit);});
}

/* 내보내기 */
function download(fn,content,type){const b=new Blob([content],{type:type||"text/plain;charset=utf-8"});
  const u=URL.createObjectURL(b);const a=document.createElement("a");a.href=u;a.download=fn;a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);}
function exportPosts(fmt){
  const data=[...POSTS].sort((a,b)=>new Date(b.posted_at||0)-new Date(a.posted_at||0));
  const stamp=new Date().toISOString().slice(0,10);
  if(!data.length){toast("내보낼 글이 없습니다",true);return;}
  if(fmt==="json"){download("유영준의책상_"+stamp+".json",
    JSON.stringify(data.map(p=>({date:p.posted_at,source:p.source,title:p.title,body:p.body,link:p.link,tags:p.tags,rating:p.rating})),null,2),"application/json");}
  else if(fmt==="md"){let md="# 유영준의 책상 · 글 아카이브\n\n총 "+data.length+"개 · "+stamp+"\n\n---\n\n";
    md+=data.map(p=>{
      const head=p.title?p.title:fmtDate(p.posted_at);
      let s="### "+head+"\n\n"+srcMeta(p.source).label+" · "+fmtDate(p.posted_at)+"\n\n"+(p.body||"")+"\n";
      if(p.link)s+="\n[원문]("+p.link+")\n";return s;}).join("\n---\n\n");
    download("유영준의책상_"+stamp+".md",md,"text/markdown;charset=utf-8");}
  else if(fmt==="html"){download("유영준의책상_"+stamp+".html",buildStandaloneHtml(data,stamp),"text/html;charset=utf-8");}
}
function buildStandaloneHtml(data,stamp){
  const items=data.map(p=>({d:fmtDate(p.posted_at),s:srcMeta(p.source).label,t:p.title||"",b:p.body||"",l:p.link||""}));
  const json=JSON.stringify(items).replace(/<\/script>/g,"<\\/script>");
  return '<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">'+
  '<title>유영준의 책상 '+stamp+'</title><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap" rel="stylesheet">'+
  '<style>*{margin:0;padding:0;box-sizing:border-box;font-style:normal}body{font-family:"Noto Sans KR",sans-serif;background:#f8faff;color:#1a2332;line-height:1.7;padding:40px 16px 80px}'+
  '.w{max-width:720px;margin:0 auto}h1{font-size:32px;font-weight:700;color:#3684FF;text-align:center}'+
  '.sub{text-align:center;color:#5a6b85;margin:10px 0 24px;font-size:14px}#s{width:100%;padding:13px 16px;border:1px solid rgba(54,132,255,.2);border-radius:12px;font-size:15px;font-family:inherit;margin-bottom:18px}#s:focus{outline:none;border-color:#3684FF}'+
  '.p{background:rgba(255,255,255,.8);border:1px solid rgba(54,132,255,.15);border-radius:16px;padding:22px 24px;margin-bottom:14px;box-shadow:0 6px 24px rgba(54,132,255,.08)}'+
  '.dt{color:#3684FF;font-weight:700;font-size:12px}.tt{font-size:16px;font-weight:700;margin:6px 0}.bd{margin-top:8px;white-space:pre-wrap;word-break:break-word;font-size:15px}.bd mark{background:rgba(54,132,255,.22);border-radius:3px}'+
  'a{color:#3684FF;font-size:13px;display:inline-block;margin-top:12px;text-decoration:none}a:hover{text-decoration:underline}</style></head>'+
  '<body><div class="w"><h1>유영준의 책상</h1><div class="sub">총 '+data.length+'개 · '+stamp+' · 경영전환전략연구소 통</div><input id="s" placeholder="검색…"><div id="l"></div></div>'+
  '<script>var D='+json+';var L=document.getElementById("l"),S=document.getElementById("s");'+
  'function esc(t){return t.replace(/[&<>]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;"}[c]})}'+
  'function hl(t,q){var s=esc(t);if(!q)return s;return s.replace(new RegExp("("+q.replace(/[.*+?^${}()|[\\]\\\\]/g,"\\\\$&")+")","gi"),"<mark>$1</mark>")}'+
  'function R(q){var d=D.filter(function(p){return !q||(p.t+" "+p.b).toLowerCase().indexOf(q.toLowerCase())>=0});'+
  'L.innerHTML=d.map(function(p){return "<div class=\\"p\\"><div class=\\"dt\\">"+p.s+" · "+p.d+"</div>"+(p.t?"<div class=\\"tt\\">"+hl(p.t,q)+"</div>":"")+"<div class=\\"bd\\">"+hl(p.b,q)+"</div>"+(p.l?"<a href=\\""+p.l+"\\" target=\\"_blank\\">원문 ↗</a>":"")+"</div>"}).join("")||"<p style=\\"text-align:center;color:#9aa7bd;padding:40px\\">결과 없음</p>"}'+
  'S.addEventListener("input",function(){R(S.value.trim())});R("");<\/script></body></html>';
}

